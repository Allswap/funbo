{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "funbo",
  "main": "src/index.ts",
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "compatibility_date": "2026-06-04",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "funbo-db",
      "database_name": "funbo-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  "kv_namespaces": [
    { "binding": "FUNBO_KV", "id": "YOUR_KV_NAMESPACE_ID" }
  ],
  "r2_buckets": [
    { "binding": "FUNBO_R2", "bucket_name": "funbo-execution-data" }
  ],
  "queues": {
    "producers": [
      { "binding": "SCAN_QUEUE", "queue": "funbo-scan-queue" },
      { "binding": "EXECUTE_QUEUE", "queue": "funbo-execute-queue" }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    { "name": "EMAIL" }
  ],
  "observability": {
    "enabled": true
  },
  "services": [
    { "binding": "EXECUTION_WORKER", "service": "funbo-execution" },
    { "binding": "DISCOVERY_WORKER", "service": "funbo-discovery" }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "EXECUTION_WORKER_URL": "https://YOUR_WORKER_NAME.YOUR_SUBDOMAIN.workers.dev",
    "DISCOVERY_WORKER_URL": "https://YOUR_WORKER_NAME.YOUR_SUBDOMAIN.workers.dev"
  }
}
